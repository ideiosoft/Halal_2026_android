<resources>


    <style name="MyMaterialTheme" parent="MyMaterialTheme.Base">
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowSharedElementEnterTransition">@android:transition/move</item>
        <item name="android:windowSharedElementExitTransition">@android:transition/move</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.FullScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>


    <style name="CustomDialog" parent="android:Theme.DeviceDefault.Dialog">
        <item name="DialogTitleAppearance">@font/regular</item>
        <item name="DialogTitleText">Loading…</item>
        <!--<item name="DialogSpotColor">@android:color/holo_orange_dark</item>-->
        <item name="DialogSpotColor">@color/spots_dialog_color</item>
        <item name="DialogSpotCount">4</item>
    </style>


    <style name="CustomRatingBar" parent="@android:style/Widget.RatingBar">
        <item name="android:progressDrawable">@drawable/ratingbar</item>
        <item name="android:minHeight">25dp</item>
        <item name="android:maxHeight">28dp</item>
    </style>

    <!-- added by Moitri -->
    <style name="CustomRatingBarGold" parent="@android:style/Widget.RatingBar">
        <item name="android:progressDrawable">@drawable/ratingbar_gold</item>
        <item name="android:minHeight">@dimen/ratingbar_minHeight</item>
        <item name="android:maxHeight">@dimen/ratingbar_maxHeight</item>
    </style>
    <!-- end -->

    <style name="CustomRatingBarSmall" parent="@android:style/Widget.RatingBar">
        <item name="android:progressDrawable">@drawable/ratingbar_list</item>
        <item name="android:minHeight">@dimen/ratingbar_small_minHeight</item>
        <item name="android:maxHeight">@dimen/ratingbar_small_minHeight</item>
    </style>


    <style name="DropDownListView" parent="@android:style/Widget.Holo.ListView.DropDown">
        <item name="android:listSelector">#2EC430</item><!--#c0392b-->
        <item name="android:divider">#bbbaba</item><!--#e74c3c-->
        <item name="android:dividerHeight">1dp</item>
        <item name="android:background">#ffffff</item>
        <item name="android:elevation">2dp</item>
    </style>


    <style name="PopupMenu" parent="@android:style/Widget.Holo.ListPopupWindow">
        <item name="android:popupBackground">#03A9F4</item>

    </style>

</resources>
