<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"


    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_20sdp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_10sdp"

            android:paddingTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_10sdp"
          >


            <ImageView
                android:id="@+id/ivClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/close_voucher"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageView
                android:id="@+id/iv_loader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/view_voucher_img"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_offer_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:maxLines="1"
                android:text="25% Off"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_11pt" />

            <TextView
                 android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:fontFamily="@font/regular"
                android:gravity="center"
                android:text="your entire bill at"
                android:textColor="@color/black"
                android:textSize="@dimen/text_11pt"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_loader" />

            <TextView
                android:id="@+id/tv_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:text="Restaurant Name"
                android:textColor="@color/black"
                android:textSize="@dimen/text_11pt"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_loader" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/_5sdp"
                android:background="@drawable/ic_bg"
                android:layout_marginTop="@dimen/_20sdp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawableLeft="@drawable/ic_info"
                    android:drawablePadding="@dimen/app_base_margin_5dp"
                    android:layout_marginStart="@dimen/_4sdp"
                     android:layout_marginEnd="@dimen/_4sdp"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:text="Present the voucher to the venue upon "
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_6pt"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_main" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_4sdp"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:text="payment to receive the % of the bill."
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_6pt"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_main" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvRateIt"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                android:background="@drawable/redeem_bg"
                 android:paddingVertical="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_20sdp"
                 android:backgroundTint="@color/black"
                android:fontFamily="@font/med"
                android:layout_marginHorizontal="@dimen/_25sdp"
                android:gravity="center"
                android:text="Call Restaurant"
                 android:textColor="@color/white"
                android:textSize="@dimen/text_9pt" />
            <TextView
                android:id="@+id/tvMenu"
                android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                android:background="@drawable/redeem_bg"
                 android:paddingVertical="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_20sdp"
                 android:backgroundTint="@color/black"
                android:fontFamily="@font/med"
                android:layout_marginHorizontal="@dimen/_25sdp"
                android:gravity="center"
                android:text="View m"
                 android:textColor="@color/white"
                android:textSize="@dimen/text_9pt" />


        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>