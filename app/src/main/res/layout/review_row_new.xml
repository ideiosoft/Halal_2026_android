<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.dapl.halaladvisor.extra.CircleImageView
            android:id="@+id/iv_review_row_userImage"
            android:layout_width="@dimen/review_image_size"
            android:layout_height="@dimen/review_image_size"
            android:src="@drawable/user_defalut"
            app:civ_border_color="@color/navigationBarColor"
            app:civ_border_width="1dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/iv_review_row_userImage"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@+id/iv_review_row_userImage"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_review_row_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/regular"
                android:text="ABC XYZ"
                android:textColor="@color/navigationBarColor"
                android:textSize="@dimen/text_8pt" />

            <RatingBar
                android:id="@+id/review_row_ratingbar"
                style="@style/CustomRatingBarSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_review_row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_review_row_userImage"
            android:layout_marginTop="@dimen/app_base_margin_10dp"
            android:fontFamily="@font/regular"
            android:text="6 months ago"
            android:textColor="@color/beforeLogin_text_color"
            android:textSize="@dimen/text_8pt" />

        <TextView
            android:id="@+id/tv_review_row_brief"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_review_row_time"
            android:layout_marginTop="@dimen/app_base_margin_5dp"
            android:fontFamily="@font/regular"
            android:text="NO COMMENTS"
            android:textColor="@color/navigationBarColor"
            android:textSize="@dimen/text_8pt" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_review_row_brief"
            android:layout_marginTop="@dimen/_5sdp" />

    </RelativeLayout>

</RelativeLayout>