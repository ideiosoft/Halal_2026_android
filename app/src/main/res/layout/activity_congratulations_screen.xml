<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray"
    tools:context=".Activity.CongratulationsScreen">

    <View
        android:layout_width="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/viewone"
        android:background="@color/colorPrimary"
        android:layout_height="1dp"/>


    <RelativeLayout
        android:id="@+id/rl_registration_header"
        android:layout_width="match_parent"
        android:background="@color/gray"
        app:layout_constraintTop_toBottomOf="@+id/viewone"
        android:layout_height="?android:attr/actionBarSize">


        <TextView
            android:id="@+id/tv_reg_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/bold"
            android:padding="@dimen/_12sdp"
            android:text="X"
            android:textColor="@color/black"
            android:textSize="@dimen/sz_login_text_header" />

    </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_registration_header"
            android:background="@color/gray"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:paddingBottom="@dimen/_30sdp"
                android:layout_height="match_parent">


                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tick"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_login_header"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/_20sdp"
                     android:layout_gravity="center"
                    android:text="Congratulations"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_30sdp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_login_header"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="You have redeemed"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_11pt" />
                <View
                    android:layout_width="match_parent"
                    android:background="@color/edittext_line_color"
                    android:layout_marginHorizontal="@dimen/_30sdp"
                    android:layout_marginVertical="@dimen/_20sdp"
                    android:layout_height="1dp"/>
                <TextView
                    android:id="@+id/tv_offer_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:layout_gravity="center"
                    android:fontFamily="@font/bold"
                    android:maxLines="1"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:textSize="@dimen/_30sdp"
                    android:gravity="center"
                    android:text="25 % Off"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_login_header"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:text="your entire bil at"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_11pt" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_login_header"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:id="@+id/tvRestName"
                    android:layout_gravity="center"
                    android:text="Restaurant Name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_11pt" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_login_header"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/regular"
                    android:layout_marginTop="@dimen/_50sdp"
                    android:gravity="center"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:layout_gravity="center"
                    android:text="Go to your My Vouchers section or tap the button below to see the voucher."
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_11pt" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Go to My Vouchers"
                    android:background="@drawable/btn_bg_round"
                    android:backgroundTint="@color/colorPrimary"
                    android:fontFamily="@font/bold"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:paddingVertical="@dimen/_10sdp"
                    android:id="@+id/tvGoToV"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textSize="@dimen/text_8pt"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:textColor="@color/white"
                    android:layout_centerInParent="true"
                    />
            </LinearLayout>


        </ScrollView>

 </androidx.constraintlayout.widget.ConstraintLayout>