    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        android:layout_below="@+id/tv_readAllReview"
        android:id="@+id/adViewSection"
        android:layout_alignParentBottom="true">




        <View
            android:id="@+id/viewthree"
            android:layout_width="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="1dp"
            android:background="@color/details_bg_color" />



        <com.google.android.gms.ads.AdView
            android:id="@+id/ad_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_5sdp"
            android:layout_marginBottom="0dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@+id/viewthree"
            app:layout_constraintBottom_toTopOf="@+id/viewFour"
            android:layout_marginStart="8dp"
            ads:adSize="BANNER"
            ads:adUnitId="@string/adsunitid"
            ads:layout_constraintBottom_toBottomOf="parent"
            ads:layout_constraintEnd_toEndOf="parent"
            ads:layout_constraintStart_toStartOf="parent" />


        <TextView
            android:id="@+id/tvMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            app:layout_constraintBottom_toTopOf="@+id/viewFour"
            android:maxLines="2"
            app:layout_constraintTop_toBottomOf="@+id/viewthree"
            android:text=""
            android:layout_marginVertical="@dimen/_18sdp"
            android:textColor="@color/navigationBarColor"
            android:gravity="center"
            android:textSize="@dimen/text_9pt"  />
        <View
            android:id="@+id/viewFour"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/adView"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="@dimen/_1sdp"
            android:background="@color/details_bg_color" />
    </androidx.constraintlayout.widget.ConstraintLayout>



</RelativeLayout>

</androidx.core.widget.NestedScrollView>
