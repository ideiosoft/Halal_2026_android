<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="220dp"
  >

    <RelativeLayout
        android:layout_width="match_parent"
        android:background="@color/colorPrimary"
        android:layout_height="120dp">

    </RelativeLayout>


    <com.dapl.halaladvisor.extra.CircleImageView
        android:id="@+id/iv_navigation_userImage"
        android:layout_width="120dp"
        android:layout_height="120dp"

        android:layout_centerInParent="true"
        android:layout_marginTop="@dimen/_10sdp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile_placeholder"
        app:civ_border_color="@color/white"
        app:civ_border_width="@dimen/_3sdp" />

    <TextView
        android:id="@+id/tv_navigation_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"

        android:layout_below="@+id/iv_navigation_userImage"
        android:layout_centerInParent="true"
        android:fontFamily="@font/regular"
        android:gravity="center_horizontal"
        android:text=""
        android:textColor="@color/black"
        android:textSize="@dimen/text_11pt" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:layout_below="@+id/tv_navigation_username"
        android:background="#999999" />


</RelativeLayout>