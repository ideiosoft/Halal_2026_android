<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    app:cardCornerRadius="@dimen/_5sdp"
    app:cardElevation="0dp"
    android:layout_height="wrap_content">


    <LinearLayout
        android:id="@+id/linBox"
        android:layout_width="@dimen/_260sdp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="@dimen/_3sdp">

        <!-- Thumbnail Image -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_150sdp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="@dimen/_5sdp"
                app:cardElevation="0dp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_height="match_parent">


                <ImageView
                    android:id="@+id/thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/list_placeholder" />
                <ImageView
                    android:visibility="gone"
                    android:layout_width="120dp"
                    android:id="@+id/featuredIv"
                    android:layout_gravity="bottom"
                    android:background="@drawable/featured_icon"
                    android:layout_height="25dp"/>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/iv_make_favorite"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="right"
                android:layout_alignParentRight="true"
                android:layout_marginTop="10dp"
                android:layout_marginRight="10dp"
                android:background="@drawable/fav_stroke" />

            <TextView
                android:id="@+id/tvFeaturedOffer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:visibility="gone"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:elevation="@dimen/_2sdp"
                android:drawableLeft="@drawable/ic_iv"
                android:drawablePadding="@dimen/_10sdp"
                android:background="@drawable/offer_bg"
                android:fontFamily="@font/med"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/_15sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="@dimen/text_9pt" />


        </RelativeLayout>


        <RelativeLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp">

            <TextView
                android:id="@+id/rowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginRight="@dimen/_10sdp"
                android:layout_toLeftOf="@+id/status"
                android:ellipsize="end"
                android:ems="9"

                android:fontFamily="@font/bold"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textAllCaps="false"
                android:textColor="@color/navigationBarColor"
                android:textSize="@dimen/text_9pt"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rowCuisineType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/rowName"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/regular"
                android:singleLine="true"
                android:textColor="#828486"
                android:textSize="@dimen/text_9pt" />
            <ImageView
                android:id="@+id/openclose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:visibility="gone" />


                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:background="@drawable/little_round_edges_bg"
                    android:fontFamily="@font/med"
                    android:gravity="center"
                    android:layout_alignParentRight="true"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_6pt" />


        </RelativeLayout>





    </LinearLayout>
</androidx.cardview.widget.CardView>





