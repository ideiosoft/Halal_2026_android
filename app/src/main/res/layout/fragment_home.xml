<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_list_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/loginCancel_green"
            android:visibility="gone" />

    </LinearLayout>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:layout_below="@+id/ll_list_header"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"


            android:background="@color/white"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/bannerLay"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_110sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@color/white"
                android:visibility="gone">
                <!-- viewpager to show images -->
                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/viewPagerMain"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    tools:ignore="SpeakableTextPresentCheck" />

                <!-- <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                     android:id="@+id/dot1"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_alignParentBottom="true"
                     android:layout_centerHorizontal="true"
                     android:layout_gravity="center_horizontal"
                     android:layout_marginTop="10dp"
                     android:paddingBottom="@dimen/_10sdp"
                     app:dotsColor="@android:color/white"
                     app:dotsSize="6dp"
                     app:dotsSpacing="5dp"
                     app:progressMode="true"
                     app:selectedDotColor="@android:color/white" />-->
            </RelativeLayout>

            <TextView
                android:id="@+id/rowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/bannerLay"

                android:layout_marginHorizontal="@dimen/_10sdp"
                android:fontFamily="@font/bold"
                android:singleLine="true"
                android:text="Popular cuisines"
                android:textAllCaps="false"
                android:textColor="@color/navigationBarColor"
                android:textSize="@dimen/text_11pt"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCuisine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rowName"
                android:layout_marginLeft="@dimen/_15sdp"

                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                app:layout_constraintTop_toBottomOf="@+id/rowName" />

            <View
                android:id="@+id/viewOne"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_5sdp"
                android:layout_below="@+id/rvCuisine"
                android:background="@color/gray"
                app:layout_constraintTop_toBottomOf="@+id/rvCuisine" />


            <LinearLayout
                android:id="@+id/clIcons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewOne"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="10dp"
                android:weightSum="2"
                app:layout_constraintTop_toBottomOf="@+id/viewOne">


                <ImageView
                    android:id="@+id/ivList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:layout_weight="0.2"
                    android:background="@drawable/selected_option"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/list" />

                <ImageView
                    android:id="@+id/ivMap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_5sdp"
                    android:layout_weight="0.2"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_room_black_24dp" />

                <EditText
                    android:id="@+id/searchVenue"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_weight="1.4"
                    android:background="@drawable/btn_bg_round"
                    android:backgroundTint="@color/gray"
                    android:drawableLeft="@drawable/ic_baseline_search_24"
                    android:drawablePadding="10dp"
                    android:hint="search by venue name"
                    android:imeOptions="actionSearch"
                    android:minHeight="35dp"
                    android:padding="@dimen/_5sdp"
                    android:singleLine="true"
                    android:textSize="12sp"
                    app:layout_constraintLeft_toRightOf="@+id/ivMap"
                    app:layout_constraintRight_toLeftOf="@+id/lt1"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView

                    android:id="@+id/lt1"
                    android:layout_width="0dp"
                    android:layout_height="39dp"
                    android:layout_marginLeft="@dimen/_5sdp"
                    android:layout_weight="0.2"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/filtersa"
                    app:layout_constraintLeft_toRightOf="@+id/searchVenue"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/crossBtn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_closee"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingRight="@dimen/_5sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvSatellite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/regular"
                        android:singleLine="true"
                        android:text="Terrain View"
                        android:textColor="@color/navigationBarColor"
                        android:textSize="@dimen/text_11pt"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvStreetView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/regular"
                        android:singleLine="true"
                        android:text="Street View"
                        android:textColor="@color/navigationBarColor"
                        android:textSize="@dimen/text_11pt"
                        android:visibility="gone" />
                </RelativeLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/popupfilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/clIcons"
                android:layout_margin="@dimen/_10sdp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/cloase"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:src="@drawable/closeicon" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/regular"
                        android:gravity="center"
                        android:text="Filter by Halal Status"
                        android:textColor="@color/black" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@color/gray" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:fontFamily="@font/regular"
                    android:gravity="start"
                    android:text="Sort"
                    android:textColor="@color/black" />

                <LinearLayout
                    android:id="@+id/sooclick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <ImageView

                        android:layout_width="0dp"
                        android:layout_height="25dp"
                        android:layout_weight="0.5"
                        android:src="@drawable/sooprecent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="2"
                        android:fontFamily="@font/regular"
                        android:gravity="start"
                        android:text="100% Halal"
                        android:textColor="@color/black" />


                    <ImageView
                        android:id="@+id/showsoopercent"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:layout_weight="0.2"
                        android:src="@drawable/checkgreen"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/hidesooprecent"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:layout_weight="0.2"

                        android:visibility="visible" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@color/black" />

                <LinearLayout
                    android:id="@+id/halaloptionclik"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <ImageView

                        android:layout_width="0dp"
                        android:layout_height="25dp"
                        android:layout_weight="0.5"
                        android:src="@drawable/halaloption" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="2"
                        android:fontFamily="@font/regular"
                        android:gravity="start"
                        android:text="Halal Options"
                        android:textColor="@color/black" />

                    <ImageView
                        android:id="@+id/halaloption"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:layout_weight="0.2"
                        android:src="@drawable/checkgreen"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/hideoption"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:layout_weight="0.2"

                        android:visibility="visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:background="@color/black" />

                <LinearLayout
                    android:id="@+id/bothclick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:orientation="horizontal">

                    <ImageView

                        android:layout_width="0dp"
                        android:layout_height="25dp"
                        android:layout_weight="0.5"
                        android:src="@drawable/bothicon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="2"
                        android:fontFamily="@font/regular"
                        android:gravity="start"
                        android:text="Both"
                        android:textColor="@color/black" />

                    <ImageView
                        android:id="@+id/showboth"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"

                        android:layout_weight="0.2"
                        android:src="@drawable/checkgreen" />

                    <ImageView
                        android:id="@+id/hideboth"
                        android:layout_width="0dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:layout_weight="0.2"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/ordernow_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginRight="35dp"
                    android:visibility="visible"
                    app:cardBackgroundColor="@color/black"
                    app:cardCornerRadius="10dp">


                    <LinearLayout

                        android:id="@+id/apply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"


                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/tv_order_now"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/rl_details_delivery"
                            android:fontFamily="@font/regular"
                            android:gravity="center"
                            android:padding="@dimen/_10sdp"
                            android:text="Apply"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/mapFragmentLay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/clIcons">

                <com.dapl.halaladvisor.Utility.CustomMapView
                    android:id="@+id/mapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />


            </RelativeLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/popupfilter"
                android:divider="@android:color/white"
                android:fadingEdge="none"
                android:paddingBottom="@dimen/_5sdp"
                android:scrollbars="none"
                android:visibility="visible"


                app:layout_constraintTop_toBottomOf="@+id/clIcons"
                tools:itemCount="2"
                tools:listitem="@layout/list_row_new" />


            <TextView
                android:id="@+id/tvLoadMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_10sdp"
                android:background="@drawable/btn_bg_round"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_8sdp"
                android:text="Load more"
                android:textColor="@color/white"
                android:textSize="@dimen/text_11pt"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBarBottom"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_gravity="center"
                android:layout_margin="@dimen/_10sdp"
                android:layout_marginVertical="@dimen/_10sdp"
                android:gravity="center"
                android:visibility="gone" />


            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true" />

            <LinearLayout
                android:id="@+id/ll_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical" />


        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>