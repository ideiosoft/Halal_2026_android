<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgStatus"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:tint="#1F7A37"
            android:background="@drawable/bg_status_icon_halal"
            android:padding="9dp"
            android:src="@drawable/ic_new_shield"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/med"

            android:maxLines="1"
            android:text="Baked Beans In Tomat.."
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@+id/txtStatusBadge"
            app:layout_constraintStart_toEndOf="@+id/imgStatus"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtBrandName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/med"
            android:maxLines="1"
            android:text="Heinz - Canned Goods"
            android:textColor="@color/d_grey"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@+id/txtTime"
            app:layout_constraintStart_toStartOf="@+id/txtProductName"
            app:layout_constraintTop_toBottomOf="@+id/txtProductName" />

        <TextView
            android:id="@+id/txtIngredientsInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/med"
            android:maxLines="1"
            android:text="No non-halal ingredients"
            android:textColor="#95DA94"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@+id/txtBrandName"
            app:layout_constraintStart_toStartOf="@+id/txtProductName"
            app:layout_constraintTop_toBottomOf="@+id/txtBrandName" />

        <TextView
            android:id="@+id/txtStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_halal"
            android:fontFamily="@font/bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="HALAL"
            android:textColor="#1F7A37"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@+id/txtTime"
            app:layout_constraintTop_toTopOf="@+id/txtProductName"
            app:layout_constraintBottom_toBottomOf="@+id/txtProductName" />

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:gravity="end"
            android:text="Today"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTimeSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/med"
            android:gravity="end"
            android:text="10:42 AM"
            android:textColor="@color/d_grey"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtTime" />

        <ImageView
            android:id="@+id/imgChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:padding="2dp"
            android:src="@drawable/image_next_arrow"
            app:tint="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtTimeSub" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
