<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="@dimen/_200sdp"
    android:layout_height="wrap_content"
    android:background="@drawable/ic_location_area"
    android:paddingHorizontal="@dimen/_8sdp"
    android:paddingBottom="@dimen/_10sdp">

    <androidx.constraintlayout.widget.ConstraintLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        >

        <TextView
            android:id="@+id/tvClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bold"
            android:linksClickable="true"
            android:padding="@dimen/_5sdp"
            android:text=" X "
            android:textColor="@color/black"
            android:textSize="@dimen/text_12pt"
            android:visibility="gone"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/imageCard"
            android:layout_width="230dp"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="@dimen/_15sdp"

            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
              />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvPlaceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_8sdp"
            android:fontFamily="@font/regular"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_9pt"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageCard" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/_8sdp"
            android:fontFamily="@font/regular"


            android:textColor="@color/black"
            android:textSize="@dimen/text_9pt"

            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPlaceName" />

        <TextView
            android:id="@+id/tvDirection1"
            android:layout_width="wrap_content"

            android:layout_height="0dp"
            android:fontFamily="@font/med"
            android:text="Get Directions"

            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_9pt"
            app:layout_constraintBottom_toTopOf="@+id/tvPhone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvAddress" />

        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:fontFamily="@font/med"
            android:text="Phone: "
            android:textColor="@color/black"

            android:textSize="@dimen/text_9pt"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent" />

        <TextView
            android:id="@+id/tvPhoneVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:fontFamily="@font/regular"
            android:text=""
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_9pt"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/tvPhone" />


        <TextView
            android:id="@+id/tvDirection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_10sdp"
            android:autoLink="all"
            android:fontFamily="@font/regular"
            android:linksClickable="true"
            android:text="Directions"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_9pt"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPhone" />

        <TextView
            android:id="@+id/tvStreetView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/regular"
            android:linksClickable="true"
            android:text="Street View"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_9pt"
            android:visibility="gone"
            app:layout_constraintLeft_toRightOf="@+id/tvDirection"
            app:layout_constraintTop_toBottomOf="@+id/tvPhoneVal" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
