    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/app_base_margin_5dp"
        android:layout_marginVertical="@dimen/_8sdp"
        android:gravity="center"

        android:orientation="vertical"
        android:weightSum="1">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
             android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_offer_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/bold"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_9pt" />

                <TextView
                    android:id="@+id/tv_offer_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"

                    android:fontFamily="@font/bold"
                    android:text=""
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/text_9pt" />



                <TextView
                    android:id="@+id/tvValidity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/regular"
                    android:text="Valid Till"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/text_6pt" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvRedeem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/redeem_bg"
                    android:fontFamily="@font/med"
                    android:gravity="center"
                    android:text="View Voucher"
                    android:paddingVertical="@dimen/_8sdp"
                    android:paddingHorizontal="@dimen/_11sdp"
                    android:layout_marginEnd="@dimen/_3sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_6pt" />
                <TextView
                    android:id="@+id/tvRateIt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/redeem_bg"
                     android:paddingVertical="@dimen/_8sdp"
                    android:backgroundTint="@color/black"
                    android:fontFamily="@font/med"
                    android:paddingHorizontal="@dimen/_11sdp"
                    android:gravity="center"
                    android:text="Rate It"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_6pt" />

            </LinearLayout>


        </LinearLayout>
        <View
            android:id="@+id/view_line"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@color/details_bg_color"
            android:paddingLeft="@dimen/_4sdp"
            android:paddingRight="@dimen/_4sdp" />
    </LinearLayout>

</layout>